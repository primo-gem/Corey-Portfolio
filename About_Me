<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Corey Wan – About</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F4F6F8;--surface:#FFFFFF;--ink:#15202B;--muted:#55636F;--line:#D9DFE5;
  --accent:#2F45C5;--accent-ink:#FFFFFF;--wash:#E6EAF8;
  --display:"Bricolage Grotesque",ui-sans-serif,system-ui,sans-serif;
  --body:"Figtree",ui-sans-serif,system-ui,sans-serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0F151B;--surface:#172029;--ink:#E8EDF2;--muted:#9AA7B3;--line:#2A3641;
    --accent:#8EA0FF;--accent-ink:#0F151B;--wash:#1E2650;
  }
}
:root[data-theme="dark"]{
  --bg:#0F151B;--surface:#172029;--ink:#E8EDF2;--muted:#9AA7B3;--line:#2A3641;
  --accent:#8EA0FF;--accent-ink:#0F151B;--wash:#1E2650;
}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.65 var(--body)}
a{color:var(--accent)}
a:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:4px}
.wrap{max-width:1080px;margin:0 auto;padding:56px 24px 72px;display:grid;grid-template-columns:290px minmax(0,1fr);gap:72px}
aside{position:sticky;top:56px;align-self:start}
.avatar{width:84px;height:84px;border-radius:50%;background:var(--accent);color:var(--accent-ink);
  display:grid;place-items:center;font:700 1.9rem var(--display);margin-bottom:24px}
h1{font:700 clamp(2.6rem,6vw,3.6rem)/1 var(--display);letter-spacing:-.025em;margin:0 0 14px}
.role{font-size:1.125rem;margin:0 0 4px}
.place{color:var(--muted);margin:0 0 28px}
nav ul{list-style:none;margin:0 0 28px;padding:0;display:grid;gap:4px}
nav a{display:inline-block;padding:4px 0;color:var(--muted);text-decoration:none;font-weight:500}
nav a:hover{color:var(--ink)}
.links{display:flex;flex-wrap:wrap;gap:8px}
.links a{padding:7px 14px;border:1px solid var(--line);border-radius:999px;background:var(--surface);
  color:var(--ink);text-decoration:none;font-size:.95rem;font-weight:500}
.links a:hover{border-color:var(--accent);color:var(--accent)}
main section{padding-top:28px;margin-bottom:56px;border-top:1px solid var(--line)}
main section:first-child{border-top:0;padding-top:0}
h2{font:700 1.5rem/1.2 var(--display);letter-spacing:-.01em;margin:0 0 20px}
.about p{max-width:62ch;margin:0 0 1em}
.about p:first-child{font-size:1.3rem;line-height:1.5;font-family:var(--display);font-weight:500}
.tl{list-style:none;margin:0;padding:0 0 0 24px;border-left:2px solid var(--line);display:grid;gap:32px}
.tl li{position:relative}
.tl li::before{content:"";position:absolute;left:-31px;top:.55em;width:12px;height:12px;border-radius:50%;
  background:var(--bg);border:2px solid var(--accent)}
.tl h3{font:600 1.1rem/1.3 var(--body);margin:0}
.tl .meta{color:var(--muted);font-size:.95rem;margin:2px 0 8px}
.tl p{margin:0;max-width:60ch}
.skills{display:grid;gap:20px;margin:0}
.skills dt{font-weight:600;margin-bottom:8px}
.skills dd{margin:0;display:flex;flex-wrap:wrap;gap:8px}
.chip{background:var(--wash);color:var(--ink);padding:4px 12px;border-radius:999px;font-size:.95rem}
.projects{list-style:none;margin:0;padding:0}
.projects li{padding:18px 0;border-bottom:1px solid var(--line)}
.projects li:first-child{padding-top:0}
.projects h3{font:600 1.1rem/1.3 var(--body);margin:0 0 4px}
.projects p{margin:0;color:var(--muted);max-width:60ch}
.contact p{margin:0 0 12px;max-width:52ch}
.mail{font:700 clamp(1.4rem,3.5vw,2rem)/1.2 var(--display);word-break:break-word}
footer{color:var(--muted);font-size:.9rem;margin-top:8px}
@media (max-width:820px){
  .wrap{grid-template-columns:1fr;gap:40px;padding-top:36px}
  aside{position:static}
  nav{display:none}
}
</style> 
</head>
<body>
<div class="wrap" id="app"></div>

<script>
/* ==========================================================
   EDIT YOUR CONTENT HERE. Everything on the page comes from
   this block. Delete a section's contents (e.g. projects: [])
   and that section disappears, including its menu link.
   ========================================================== */
const CONTENT = {
  name: "Corey Wan",
  role: "High school student",
 
  about: [
    "I'm a softmore at Emerald High School, where I write in C++ and Python, often work with my school's robotics team, and speak Mandarin.",
    "Outside of class, I've played club soccer since 2016, played club lacrosse, refereed youth soccer games, and enjoy tinkering with electronics."
  ],

  experience: [
    { role: "Vice President", org: "East and Southeast Asian Society", dates: "Oct 2025 – Present",
      summary: "Help lead a student club at Emerald High School." },
    { role: "Booth Vendor / Manager", org: "Emerald High School Booster, Stoneridge Mall", dates: "Sep 2025",
      summary: "Managed and guided several game booths at a fundraising event, keeping guests entertained while working with a team." },
    { role: "Member", org: "Emerald High School Robotics Team", dates: "Oct 2023 – Present",
      summary: "Codes Software, as well as attend Outreach events." },
    { role: "Referee", org: "Nor-Cal Referee Association", dates: "Aug 2023 – Oct 2024",
      summary: "Refereed soccer games for boys and girls ages 9 to 14, practicing communication, delegating, and supervising." },
    { role: "Student", org: "Emerald High School", dates: "2025 – 2029",
      summary: "3.94 weighted GPA (3.81 unweighted)." }
  ],

  skills: [
    { group: "Programming", items: ["C++ (proficient/advanced)", "Python (proficient/advanced)", "Java", "HTML"] },
    { group: "Languages", items: ["Mandarin (proficient)", "English"] },
    { group: "Making", items: ["Robotics building", "Video directing", "Video editing"] },
    { group: "People skills", items: ["Teamwork", "Supervising", "Delegating", "Communication"] }
  ],

  projects: [
    { title: "Scholar Athlete Award", description: "Recognized for excelling in academics while playing on a school sports team.", url: "" },
    { title: "JV Soccer MVP, 2025–26", description: "Named MVP of the JV school soccer team, November 2025 to February 2026.", url: "" }
  ],

  contact: {
    note: "I'm open to any contact. The best way to reach me is email.",
    email: "coreywan2010@gmail.com",
    links: [
      { label: "LinkedIn", url: "https://www.linkedin.com/in/corey-wan-270987438" },
      { label: "GitHub", url: "https://github.com/primo-gem" }
    ]
  }
};
/* ============== end of editable content ============== */

function el(tag, props, kids){
  const n = document.createElement(tag);
  for (const k in (props || {})){
    if (k === "text") n.textContent = props[k];
    else n.setAttribute(k, props[k]);
  }
  [].concat(kids || []).forEach(c => n.append(c));
  return n;
}
function safeUrl(u){ return /^(https?:|mailto:)/i.test(u) ? u : ""; }
function link(label, url, cls){
  const a = el("a", { text: label, href: safeUrl(url) || "#" , class: cls || "" });
  if (/^https?:/i.test(url)) { a.target = "_blank"; a.rel = "noopener noreferrer"; }
  return a;
}

const C = CONTENT, app = document.getElementById("app");
const initials = C.name.split(/\s+/).map(w => w[0]).slice(0, 2).join("").toUpperCase();
const sections = [];

if (C.about && C.about.length){
  sections.push({ id: "about", title: "About", node: el("div", { class: "about" }, C.about.map(t => el("p", { text: t }))) });
}
if (C.experience && C.experience.length){
  sections.push({ id: "experience", title: "Experience", node: el("ol", { class: "tl" }, C.experience.map(x =>
    el("li", {}, [
      el("h3", { text: x.role }),
      el("p", { class: "meta", text: x.org + "  |  " + x.dates }),
      el("p", { text: x.summary })
    ])))});
}
if (C.skills && C.skills.length){
  const dl = el("dl", { class: "skills" });
  C.skills.forEach(g => {
    dl.append(el("dt", { text: g.group }));
    dl.append(el("dd", {}, g.items.map(i => el("span", { class: "chip", text: i }))));
  });
  sections.push({ id: "skills", title: "Skills", node: dl });
}
if (C.projects && C.projects.length){
  sections.push({ id: "projects", title: "Awards", node: el("ul", { class: "projects" }, C.projects.map(p =>
    el("li", {}, [
      el("h3", {}, p.url ? link(p.title, p.url) : p.title),
      el("p", { text: p.description })
    ])))});
}
if (C.contact){
  const box = el("div", { class: "contact" });
  if (C.contact.note) box.append(el("p", { text: C.contact.note }));
  if (C.contact.email) box.append(el("p", {}, link(C.contact.email, "mailto:" + C.contact.email, "mail")));
  sections.push({ id: "contact", title: "Contact", node: box });
}

document.title = C.name + " – About";

const side = el("aside", {}, [
  el("div", { class: "avatar", "aria-hidden": "true", text: initials }),
  el("h1", { text: C.name }),
  el("p", { class: "role", text: C.role }),
  el("p", { class: "place", text: C.location }),
  el("nav", { "aria-label": "Sections" }, el("ul", {}, sections.map(s =>
    el("li", {}, el("a", { href: "#" + s.id, text: s.title }))))),
  el("div", { class: "links" }, (C.contact && C.contact.links || []).map(l => link(l.label, l.url)))
]);

const main = el("main", {}, sections.map(s =>
  el("section", { id: s.id, "aria-labelledby": s.id + "-h" }, [ el("h2", { id: s.id + "-h", text: s.title }), s.node ])));
main.append(el("footer", { text: "© " + new Date().getFullYear() + " " + C.name }));

app.append(side, main);
</script>
</body>
</html>

